rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isOrgMember(orgId) {
      return isAuthenticated() && exists(/databases/$(database)/documents/organizationMembers/$(orgId + '_' + request.auth.uid));
    }

    // User profiles: Users can read and write their own document
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Organizations:
    // Any authenticated user can create an organization during onboarding
    // Members can read or update their organization
    match /organizations/{orgId} {
      allow create: if isAuthenticated();
      allow read, update: if isOrgMember(orgId);
    }

    // Organization Memberships:
    // A user can read memberships matching their own userId or for orgs they belong to
    // A user can create a membership where they are the assigned member
    match /organizationMembers/{membershipId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isOrgMember(resource.data.organizationId)
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOrgMember(resource.data.organizationId);
    }

    // Programmes, sessions, attendees, registrations:
    match /programmes/{programmeId} {
      allow read, write: if isAuthenticated() && isOrgMember(resource.data.organizationId);
      allow create: if isAuthenticated() && isOrgMember(request.resource.data.organizationId);
    }

    match /programmeFields/{fieldId} {
      allow read, write: if isAuthenticated() && isOrgMember(resource.data.organizationId);
      allow create: if isAuthenticated() && isOrgMember(request.resource.data.organizationId);
    }

    match /registrations/{regId} {
      allow read, write: if isAuthenticated() && isOrgMember(resource.data.organizationId);
      allow create: if isAuthenticated();
    }

    match /attendanceSessions/{sessionId} {
      allow read, write: if isAuthenticated() && isOrgMember(resource.data.organizationId);
      allow create: if isAuthenticated() && isOrgMember(request.resource.data.organizationId);
    }

    match /attendanceRecords/{recordId} {
      allow read, write: if isAuthenticated() && isOrgMember(resource.data.organizationId);
      allow create: if isAuthenticated() && isOrgMember(request.resource.data.organizationId);
    }

    // Credentials & Verification:
    match /credentialTemplates/{templateId} {
      allow read, write: if isAuthenticated() && isOrgMember(resource.data.organizationId);
      allow create: if isAuthenticated() && isOrgMember(request.resource.data.organizationId);
    }

    match /credentials/{credentialId} {
      allow read: if true; // Public verification allowed
      allow write: if isAuthenticated() && isOrgMember(resource.data.organizationId);
      allow create: if isAuthenticated() && isOrgMember(request.resource.data.organizationId);
    }

    // Logs:
    match /auditLogs/{logId} {
      allow read: if isAuthenticated() && isOrgMember(resource.data.organizationId);
      allow create: if isAuthenticated();
    }

    match /securityLogs/{logId} {
      allow read, write: if isAuthenticated();
    }
  }
}
